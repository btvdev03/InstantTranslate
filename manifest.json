{
  "manifest_version": 3,
  "name": "InstantTranslate - Dịch Chuột Nhanh & Miễn Phí",
  "short_name": "InstantTranslate",
  "version": "1.1.0",
  "description": "Dịch văn bản bôi đen tức thì, 100% miễn phí, không cần API Key. Tích hợp từ điển chi tiết, phát âm và thay thế văn bản tại chỗ.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Cài đặt InstantTranslate"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://clients5.google.com/*",
    "https://translate.google.com/*",
    "https://api.mymemory.translated.net/*"
  ]
}
